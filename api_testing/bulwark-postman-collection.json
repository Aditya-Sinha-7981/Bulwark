    {
      "name": "5. Knowledge Base",
      "item": [
        {
          "name": "Ingest KB Document",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/knowledge-base/documents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "knowledge-base",
                "documents"
              ]
            },
            "description": "Multipart: field 'file' (.txt/.md/.markdown/.pdf only) + optional 'metadata' as a JSON STRING (not nested form fields). Point 'file' at fixtures/sop-fire-safety.txt or sop-equipment-maintenance.txt. Sets {{kbDocumentId}}. Returns 202 'ingesting' -- poll 'List KB Documents' until status is 'ready'.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "metadata",
                  "type": "text",
                  "value": "{\"title\": \"Fire Safety SOP\", \"category\": \"safety\"}"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) {",
                  "    const json = pm.response.json();",
                  "    pm.environment.set('kbDocumentId', json.kb_document_id);",
                  "    console.log('Set {{kbDocumentId}} =', json.kb_document_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List KB Documents",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/knowledge-base",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "knowledge-base"
              ]
            },
            "description": "Poll after ingesting until the document's status is 'ready' before running a Workflow A/C job against it."
          },
          "response": []
        },
        {
          "name": "Delete KB Document",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/knowledge-base/documents/{{kbDocumentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "knowledge-base",
                "documents",
                "{{kbDocumentId}}"
              ]
            }
          },
          "response": []
