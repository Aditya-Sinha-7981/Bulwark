      "name": "1. Conversations",
      "item": [
        {
          "name": "Create Conversation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/conversations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "conversations"
              ]
            },
            "description": "POST /api/v1/conversations. Body is ignored/empty. Sets {{conversationId}} from the response for downstream requests.",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) {",
                  "    const json = pm.response.json();",
                  "    pm.environment.set('conversationId', json.conversation_id);",
                  "    console.log('Set {{conversationId}} =', json.conversation_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Conversation",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/conversations/{{conversationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "conversations",
                "{{conversationId}}"
              ]
            },
            "description": "Returns conversation metadata + ordered messages[]."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Jobs",
      "item": [
        {
          "name": "Create Job",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/jobs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "jobs"
              ]
            },
            "description": "Creates a Job and runs it in the background. Sets {{jobId}}. Poll 'Get Job Status' until status is completed/failed.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"conversation_id\": \"{{conversationId}}\",\n  \"message\": \"What does the SOP say about X?\",\n  \"document_ids\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) {",
                  "    const json = pm.response.json();",
                  "    pm.environment.set('jobId', json.job_id);",
                  "    console.log('Set {{jobId}} =', json.job_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Job Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/jobs/{{jobId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "jobs",
                "{{jobId}}"
              ]
            },
            "description": "Poll this. status: created|running|completed|failed. artifact_ids[] appears here once create_docx/create_xlsx succeeds."
          },
          "response": []
        },
        {
          "name": "Get Job Trace",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/jobs/{{jobId}}/trace",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "jobs",
                "{{jobId}}",
                "trace"
              ]
            },
            "description": "Full ordered audit-event trace for this job (policy_decision, tool_invoked, model_invoked, artifact_created, job_completed, ...)."
          },
          "response": []
        },
        {
          "name": "Stream Job Events (SSE)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/jobs/{{jobId}}/events?replay=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "jobs",
                "{{jobId}}",
                "events"
              ],
              "query": [
                {
                  "key": "replay",
                  "value": "true"
                }
              ]
            },
            "description": "Server-Sent Events live stream, same event shape as /trace. Postman's VS Code extension may not render SSE well -- curl -N is the reliable fallback (see docs/api-manual-testing-guide.md)."
          },
          "response": []
        }
      ]
